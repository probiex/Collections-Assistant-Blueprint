{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F7F3EC" },
      "foreground": { "$value": "#2C2A24" },
      "border": { "$value": "#E5DDCD" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#2C2A24" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#2C2A24" },
      "primary": {
        "$value": "#5C7460",
        "$description": "Botanical sage for primary actions, links, progress, and calm emphasis."
      },
      "primaryForeground": { "$value": "#F7F3EC" },
      "secondary": { "$value": "#EFE6D6" },
      "secondaryForeground": { "$value": "#4A4434" },
      "muted": { "$value": "#F1EBDF" },
      "mutedForeground": { "$value": "#8A8273" },
      "accent": { "$value": "#D9C58A" },
      "accentForeground": { "$value": "#3B3527" },
      "destructive": { "$value": "#C05B3E" },
      "destructiveForeground": { "$value": "#FFF9F3" },
      "input": { "$value": "#D6CDBE" },
      "ring": { "$value": "#5C7460" },
      "chart1": { "$value": "#5C7460" },
      "chart2": { "$value": "#C77B53" },
      "chart3": { "$value": "#8A9A5B" },
      "chart4": { "$value": "#6B7B8C" },
      "chart5": { "$value": "#9C7A97" },
      "sidebar": { "$value": "#2E372E" },
      "sidebarForeground": { "$value": "#F1EEE4" },
      "sidebarBorder": { "$value": "#414C40" },
      "sidebarPrimary": { "$value": "#D9C58A" },
      "sidebarPrimaryForeground": { "$value": "#2C2A24" },
      "sidebarAccent": { "$value": "#3C463B" },
      "sidebarAccentForeground": { "$value": "#F1EEE4" },
      "sidebarRing": { "$value": "#9DB48C" }
    },
    "dark": {
      "background": { "$value": "#1F211D" },
      "foreground": { "$value": "#F4EFE5" },
      "border": { "$value": "#414C40" },
      "card": { "$value": "#2E372E" },
      "cardForeground": { "$value": "#F4EFE5" },
      "popover": { "$value": "#343A32" },
      "popoverForeground": { "$value": "#F4EFE5" },
      "primary": { "$value": "#9DB48C" },
      "primaryForeground": { "$value": "#1F211D" },
      "secondary": { "$value": "#4A4434" },
      "secondaryForeground": { "$value": "#F1EEE4" },
      "muted": { "$value": "#343A32" },
      "mutedForeground": { "$value": "#A9B8A4" },
      "accent": { "$value": "#D9C58A" },
      "accentForeground": { "$value": "#2C2A24" },
      "destructive": { "$value": "#D97A5C" },
      "destructiveForeground": { "$value": "#211815" },
      "input": { "$value": "#596457" },
      "ring": { "$value": "#9DB48C" },
      "chart1": { "$value": "#9DB48C" },
      "chart2": { "$value": "#D4936F" },
      "chart3": { "$value": "#B0BE7D" },
      "chart4": { "$value": "#8FA1B1" },
      "chart5": { "$value": "#B893B2" },
      "sidebar": { "$value": "#171A16" },
      "sidebarForeground": { "$value": "#F1EEE4" },
      "sidebarBorder": { "$value": "#343A32" },
      "sidebarPrimary": { "$value": "#D9C58A" },
      "sidebarPrimaryForeground": { "$value": "#2C2A24" },
      "sidebarAccent": { "$value": "#343A32" },
      "sidebarAccentForeground": { "$value": "#F1EEE4" },
      "sidebarRing": { "$value": "#9DB48C" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Karla", "sans-serif"],
        "$description": "Warm, highly legible UI and body typeface."
      },
      "serif": {
        "$value": ["Fraunces", "serif"],
        "$description": "Editorial display face for calm, expressive headings and key figures."
      },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1.5rem",
      "$description": "Generous organic corner radius; pills may use fully rounded ends."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
